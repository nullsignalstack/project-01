# Copy to .env. These credentials are for local development only.
POSTGRES_USER=people
POSTGRES_PASSWORD=local-people-password
POSTGRES_DB=people
DATABASE_URL=postgresql://people:local-people-password@localhost:5432/people
SESSION_SECRET=local-only-change-this-to-a-random-secret-32-chars
APP_URL=http://localhost:8080
OIDC_ISSUER=http://keycloak.localhost:8081/realms/people
OIDC_CLIENT_ID=people-space
OIDC_CLIENT_SECRET=local-only-people-space-client-secret
OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
KEYCLOAK_ADMIN_PASSWORD=local-admin-password
NODE_ENV=development
